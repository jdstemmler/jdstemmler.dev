---
// The site's signature element: what it looked like over what it was.
// Symptom in --muted; cause in full text weight, marked by a --signal label.
// The cause line's reveal one beat after load is the entire site's motion budget.
interface Props {
  symptom: string;
  cause: string;
}

const { symptom, cause } = Astro.props;
---

<div class="readout" role="group" aria-label="Diagnosis">
  <div class="row symptom">
    <div class="cell-label"><span class="label">Symptom</span></div>
    <div class="cell-value"><p class="sym-text">{symptom}</p></div>
  </div>
  <div class="row cause">
    <div class="cell-label"><span class="label">Cause</span></div>
    <div class="cell-value"><p class="cause-text">{cause}</p></div>
  </div>
</div>

<style>
  /* A quiet raised panel: the only boxed element in an article header. */
  .readout {
    margin: 0 0 2.4rem;
    background: var(--ink-2);
    border: 1px solid var(--rule);
    border-radius: 10px;
  }
  .row {
    display: grid;
    grid-template-columns: 5.2rem minmax(0, 1fr);
    gap: 0.2rem 1rem;
    padding: 0.95rem 1.15rem;
  }
  .row + .row {
    border-top: 1px solid var(--rule);
  }
  .cell-label {
    padding-top: 0.12rem;
  }
  .cell-label .label {
    font-size: 0.8rem;
  }
  .row.cause .label {
    color: var(--signal);
  }
  .cell-value p {
    margin: 0;
    line-height: 1.5;
  }
  .sym-text {
    font-size: 0.95rem;
    color: var(--muted);
  }
  .cause-text {
    font-weight: 500;
    color: var(--paper);
  }

  @media (prefers-reduced-motion: no-preference) {
    .row.cause .cause-text {
      opacity: 0;
      transform: translateY(4px);
      animation: reveal 420ms cubic-bezier(0.2, 0.7, 0.2, 1) 180ms forwards;
    }
    @keyframes reveal {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }

  @media (max-width: 620px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
