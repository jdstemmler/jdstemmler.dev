# the real company codes and questions never live in this repo.
SURVEY_CONFIG={"EXAMPLE-CODE":{"company":"Example Co","questions":[{"id":"liking","label":"What is working well for you?"},{"id":"frustrating","label":"What do you find frustrating?"}]}}
